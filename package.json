{
  "name": "landmark-audit",
  "version": "0.1.0",
  "description": "Fetches every route of a server-rendered app and requires exactly one main landmark and one skip link, reading React flight payloads for streamed routes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zz-plant/landmark-audit.git"
  },
  "homepage": "https://github.com/zz-plant/landmark-audit#readme",
  "bugs": "https://github.com/zz-plant/landmark-audit/issues",
  "author": "Kanav Jain",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "accessibility",
    "a11y",
    "landmark",
    "skip-link",
    "main",
    "next",
    "app-router",
    "rsc",
    "ci"
  ],
  "engines": {
    "bun": ">=1.1",
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.9.2"
  },
  "bin": {
    "landmark-audit": "./dist/cli.js"
  }
}
